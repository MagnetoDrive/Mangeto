# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (Optional fallbacks already exists)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# Dodo Payments Configuration (Merchant of Record)
DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_WEBHOOK_SECRET=""
DODO_PAYMENTS_ENVIRONMENT="test"
DODO_PAYMENTS_RETURN_URL=""

# Dodo Payments Product IDs
DODO_PAYMENTS_PRO_MONTHLY_PRODUCT_ID=""
DODO_PAYMENTS_PRO_YEARLY_PRODUCT_ID=""
DODO_PAYMENTS_AGENCY_MONTHLY_PRODUCT_ID=""
DODO_PAYMENTS_AGENCY_YEARLY_PRODUCT_ID=""
DODO_PAYMENTS_DEV_SPRINT_PRODUCT_ID=""

# Client-side Dodo Payments overlay configuration
VITE_DODO_PAYMENTS_MODE="test"

